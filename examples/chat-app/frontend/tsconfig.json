{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "/_concave/*": ["../../../client/concave-client/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../../client/concave-client/src/**/*.ts"]
}
