        PEND:MutSet, INFL:MutSet, REJ:MutSet, OQ:OptQueue, nilOut, DROPS:Nat)
    || srv(STS:Nat, SVAL:Nat, C:Nat)
    || net(emptyC2S, nilTr, emptyMr)
  such that (PEND:MutSet =/= emptyMS) or (OQ:OptQueue =/= nilOpt) .

--- [FIXED 3] Exact quiescent convergence: after all frames drain, client UI
