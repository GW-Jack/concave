    || srv(STS:Nat, SVAL:Nat, SSUB:Nat)
    || net(C2S:C2SBag, TQ:TrQueue, MB:MrBag)
  such that inMS(m1, REJ:MutSet) and inMS(m2, PEND:MutSet) .

