{
  "name": "@concave/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-dependency native ESM WebSocket sync engine and fine-grained reactive signal/DOM runtime for Concave (with .d.ts declarations)",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./signals": {
      "types": "./src/signals.d.ts",
      "default": "./src/signals.js"
    },
    "./dom": {
      "types": "./src/dom.d.ts",
      "default": "./src/dom.js"
    }
  }
}
